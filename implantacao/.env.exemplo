# ===== Ecossistema Nexor de uma empresa =====
# Copie para .env (o instalar.sh faz isso e gera as chaves). NÃO envie este arquivo para ninguém.

# Identificador curto da empresa (letras minúsculas, números e hífen). Separa volumes e rede.
EMPRESA=padaria-pao-dourado

# ---- Nexor RH ----
RH_PUBLIC_URL=https://rh.paodourado.com.br
RH_DOMINIO=rh.paodourado.com.br
# Gerada pelo instalar.sh. GUARDE NO COFRE DA NEXOR: sem ela o certificado e os arquivos não abrem.
RH_MASTER_KEY=
# Acesso direto pela rede local. Vazio = só pelo endereço HTTPS. Ex.: 0.0.0.0:8791 libera aos computadores da empresa
RH_PORTA_LOCAL=
APP_STORE_URL=
PLAY_STORE_URL=
APK_URL=

# ---- HTTPS pela Cloudflare (perfil tunel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Nexor Central (licença, cobrança automática e acesso de suporte) ----
# Copie as 4 linhas mostradas na Central ao cadastrar o sistema do cliente (Clientes → Sistemas → Novo)
NEXOR_CENTRAL_URL=
NEXOR_INSTANCIA=
NEXOR_TOKEN=
NEXOR_CHAVE_PUBLICA=
# Atende IA e Nexor Agente: cada um é um "sistema" à parte na Central (instância e token próprios).
# A URL da Central e a chave pública são as mesmas de cima.
ATENDE_NEXOR_INSTANCIA=
ATENDE_NEXOR_TOKEN=
AGENTE_NEXOR_INSTANCIA=
AGENTE_NEXOR_TOKEN=

# ---- Opcionais ----
ANTHROPIC_API_KEY=
ATENDE_PUBLIC_URL=
ATENDE_DOMINIO=
ATENDE_MASTER_KEY=
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
AGENTE_DONOS=
AGENTE_WHATSAPP_TOKEN=
AGENTE_WHATSAPP_PHONE_NUMBER_ID=
AGENTE_WHATSAPP_VERIFY_TOKEN=
AGENTE_WHATSAPP_APP_SECRET=
NEXOR_RH_CHAVE=
BACKUP_MANTER=14
# Pastas desta empresa (no servidor da Nexor, cada empresa tem as suas)
BACKUP_PASTA=./backups
CONECTORES_ARQUIVO=./conectores.json
