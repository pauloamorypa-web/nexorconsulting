# Nexor Agente — copie para .env (ou cadastre no Render) e preencha
ANTHROPIC_API_KEY=
NEXOR_MODEL=claude-opus-5-5
NEXOR_EFFORT=medium

# Números que podem dar ordens ao agente (DDI+DDD+número, só dígitos, separados por vírgula)
DONOS=5534999999999

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Sistemas conectados (arquivo JSON) e as credenciais usadas nele com ${NOME}
CONECTORES=./conectores.json
CRM_TOKEN=
ERP_API_KEY=

DATA_DIR=./dados
