# Nexor Elo (desenvolvimento local). Em produção, os valores ficam no cofre da Nexor.
PORT=8796
DATA_DIR=./data
# Endereço público (vai nos links das propostas e das OS): https://elo.nexorconsulting.com.br
PUBLIC_URL=
# Obrigatória em produção: cifra walletIds, tokens da Focus, chaves do Asaas e o token do webhook. GUARDE NO COFRE.
MASTER_KEY=
# Proxies confiáveis na frente (Cloudflare Tunnel, Caddy). 0 (padrão) = ignora o X-Forwarded-For.
TRUST_PROXY=0
# Código para criar o primeiro operador Nexor (sem ele, em produção é gerado em DATA_DIR/codigo-instalacao.txt)
INSTALL_CODE=
SESSION_DAYS=7

# Asaas da PLATAFORMA (cria as cobranças das propostas com split). Também pode ser salvo cifrado pelo operador Nexor.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
NEXOR_WALLET_ID=
# Taxa da plataforma sobre a proposta paga, em pontos-base (250 = 2,5%). Fica com a Nexor e cobre a tarifa do Asaas.
TAXA_PLATAFORMA_BPS=250

# Consulta de CNPJ (BrasilAPI) e dias de cache da resposta
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_CACHE_DIAS=30

# Focus NFe: homologacao ou producao (o token é de cada fornecedor/instalador, salvo cifrado no painel)
FOCUS_AMBIENTE=homologacao

# Notificações (sem configurar, o envio fica registrado como "sem_canal")
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
META_GRAPH_VERSION=v23.0
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_DE=Nexor Elo <elo@nexorconsulting.com.br>

# Fotos das OS (KB por foto) e intervalo da rotina (expiração de reservas e títulos vencidos)
FOTO_MAX_KB=600
ROTINA_MINUTOS=5

# Modo Demonstração: npm run demo (DEMO=1, dados fictícios, só 127.0.0.1, nada sai da máquina)
# DEMO=1
# DEMO_RESET=1
