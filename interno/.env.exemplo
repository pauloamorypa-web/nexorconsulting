# ===== Servidor interno da Nexor =====  (o instalar.sh cria o .env e gera as chaves; NÃO envie para ninguém)

# ---- Nexor Central ----
CENTRAL_PUBLIC_URL=https://central.nexorconsultingit.com.br
# GUARDE NO COFRE: protege o 2FA da equipe
CENTRAL_MASTER_KEY=
SUPPORT_WHATSAPP=5534997337499
SUPPORT_EMAIL=contato@nexorconsultingit.com.br
# Cobrança automática (opcional): Asaas → Integrações
ASAAS_API_KEY=
ASAAS_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ---- Blue / Nexor Assist (chat do site e WhatsApp comercial) ----
ANTHROPIC_API_KEY=
NEXOR_MODEL=claude-opus-5-5
NEXOR_EFFORT=low
ALLOWED_ORIGINS=https://nexorconsultingit.com.br,https://www.nexorconsultingit.com.br,https://pauloamorypa-web.github.io
LEAD_WEBHOOK_URL=
# Gerado pelo instalar.sh: protege o relatório de campanhas (GET /api/relatorio)
REPORT_TOKEN=
META_PIXEL_ID=
META_CAPI_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Gerado pelo instalar.sh: cole na Meta → Webhooks
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TEAM_WHATSAPP=5534997337499

# ---- HTTPS (Cloudflare Tunnel com dois hostnames: central → central:8800, api → assist:8787) ----
TUNNEL_TOKEN=
