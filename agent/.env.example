# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo e esforço (low = respostas rápidas e mais baratas; medium = mais elaboradas)
NEXOR_MODEL=claude-opus-5-5
NEXOR_EFFORT=low

# Sites que podem usar o chat (separados por vírgula)
ALLOWED_ORIGINS=https://nexorconsultingit.com.br,https://www.nexorconsultingit.com.br,https://pauloamorypa-web.github.io

# Opcional: recebe cada lead/agendamento em JSON (n8n, Make, Zapier, Google Apps Script, CRM)
LEAD_WEBHOOK_URL=

# Relatório de campanhas: GET /api/relatorio?dias=7&analise=1 com o cabeçalho Authorization: Bearer <token>
REPORT_TOKEN=

# Conversão offline vinda da Nexor Central (POST /api/conversao: teste ativado e contrato fechado).
# Vazio: usa o REPORT_TOKEN. Coloque o mesmo valor em CONVERSAO_TOKEN da Central.
CONVERSAO_TOKEN=

# API de Conversões da Meta (Gerenciador de Eventos → seu conjunto de dados → Configurações)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Código de teste (aba "Testar eventos"). Apague depois de testar.
META_TEST_EVENT_CODE=
# Conversas do WhatsApp vindas de anúncio de clique para o WhatsApp também viram eventos (Lead,
# LeadQualificado, AgendouDemo). Ligue (1) só depois de prever isso na política de privacidade.
META_CAPI_WHATSAPP=0
# Conta do WhatsApp Business (necessária para os eventos de conversas do WhatsApp)
META_WABA_ID=

# Google Ads: nomes das conversões offline. O servidor não chama a API do Google: ele manda as linhas
# (com gclid) para LEAD_WEBHOOK_URL, para importar por planilha, n8n ou Zapier.
GOOGLE_CONVERSAO_LEAD=Lead
GOOGLE_CONVERSAO_QUALIFICADO=LeadQualificado
GOOGLE_CONVERSAO_DEMO=AgendouDemo
# Conversões offline vindas da Central (teste de 30 dias ativado e contrato fechado)
GOOGLE_CONVERSAO_TESTE=TesteAtivado
GOOGLE_CONVERSAO_CONTRATO=Contrato

# Campanhas: 1 = a Blue pode citar o preço de entrada de cada produto (tabela comercial ainda em validação)
CAMPANHA_MOSTRAR_PRECO=0

# WhatsApp Cloud API (Meta for Developers → seu app → WhatsApp → Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-um-texto-secreto
WHATSAPP_APP_SECRET=
# Número que recebe os avisos da equipe (DDI + DDD + número)
TEAM_WHATSAPP=5534997337499

# Agenda do diagnóstico (horário de Brasília)
AGENDA_HORARIOS=09:00,10:30,14:00,15:30,17:00
AGENDA_DIAS_ADIANTE=10
AGENDA_ANTECEDENCIA_HORAS=3
