{
  "name": "nexor-rh-mobile",
  "version": "1.0.0",
  "description": "App nativo (iOS e Android) do Nexor RH: ponto com biometria, QR Code e GPS",
  "private": true,
  "type": "module",
  "scripts": {
    "configurar": "node scripts/configurar.mjs",
    "icones": "capacitor-assets generate --iconBackgroundColor '#010524' --iconBackgroundColorDark '#010524' --splashBackgroundColor '#010524' --splashBackgroundColorDark '#010524'",
    "sync": "npm run configurar && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.5.3"
  }
}
