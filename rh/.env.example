# Porta do servidor
PORT=8791
# Endereço público com HTTPS (usado no QR Code, nos links do app e na biometria)
PUBLIC_URL=https://rh.suaempresa.com.br
NODE_ENV=production
# Proxies reversos na frente do servidor (Render, nginx...). 0 = acesso direto, sem proxy
TRUST_PROXY=1
# Pasta do banco e dos arquivos (use um disco persistente)
DATA_DIR=./data
# Chave que criptografa o certificado digital e os arquivos. Texto aleatório longo. GUARDE-A.
MASTER_KEY=
# Permitir que novas empresas criem conta pela tela de login (multiempresa)
ALLOW_SIGNUP=false
# Duração das sessões (dias)
SESSION_DAYS=14
APP_SESSION_DAYS=90
# Validade de cada QR Code do quiosque (segundos)
QR_SECONDS=30
# CNPJ do desenvolvedor do REP-P (aparece no AFD e no AEJ)
DEVELOPER_CNPJ=

# App nativo "Meu Ponto" (ver mobile/README.md)
APP_ID=br.com.nexorconsultingit.ponto
APP_STORE_URL=
PLAY_STORE_URL=
APK_URL=
# Para o QR Code abrir direto o app: Team ID da Apple e SHA-256 do certificado Android (separe vários por vírgula)
APPLE_TEAM_ID=
ANDROID_SHA256=

# LGPD
# Versão vigente dos Termos de Uso e da Política de Privacidade. Mudou o valor, todo usuário do painel aceita de novo.
TERMOS_VERSAO=2026-11-09
# Endereço dos termos mostrado na tela de aceite
TERMOS_URL=
# Prazos de guarda em meses, por cima dos padrões (ver GET /api/lgpd/prazos). Ex.: {"lead": 6}
# Categorias de guarda legal (trabalhista, fiscal) só bloqueiam: nunca viram exclusão automática.
LGPD_PRAZOS=
# Rotina diária de expurgo (false desliga; o administrador ainda pode rodar pelo painel/API)
LGPD_ROTINA=true
