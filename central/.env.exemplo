# ===== Nexor Central =====
# Copie para .env e preencha. NÃO envie este arquivo para ninguém e não coloque no Git.

# Endereço público da Central (HTTPS). É o que os sistemas dos clientes usam para sincronizar.
PUBLIC_URL=https://central.nexorconsultingit.com.br

# Criptografa os segredos do 2FA. Gere com:  openssl rand -base64 48
# GUARDE NO COFRE: sem ela, a equipe precisa configurar o 2FA de novo.
MASTER_KEY=

# Token do túnel da Cloudflare (Zero Trust → Networks → Tunnels → Public Hostname: central.… → http://central:8800)
TUNNEL_TOKEN=

# Contato que aparece na tela de sistema suspenso dos clientes
SUPPORT_WHATSAPP=55
SUPPORT_EMAIL=contato@nexorconsultingit.com.br

# Cobrança automática pelo Asaas (opcional). Sem chave, a cobrança é manual (botão "Recebida").
# Chave: Asaas → Minha conta → Integrações → Chave de API. Sandbox: ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_URL=https://api.asaas.com/v3
# Asaas → Integrações → Webhooks → URL: https://central.…/api/webhooks/asaas · Token de autenticação: o mesmo daqui
ASAAS_WEBHOOK_TOKEN=

# Régua padrão (dias depois do vencimento). Cada cliente pode ter a sua.
RULE_WARN_DAYS=1
RULE_RESTRICT_DAYS=10
RULE_BLOCK_DAYS=20
RULE_INVOICE_DAYS=10
