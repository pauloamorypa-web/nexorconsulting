# Nexor Barber (desenvolvimento local). Na implantação, use implantacao/.env (instalar.sh).
PORT=8795
DATA_DIR=./data
# Endereço público do app (vai nos links do WhatsApp): https://agenda.suabarbearia.com.br
PUBLIC_URL=
# Obrigatória em produção: criptografa os tokens do WhatsApp, SMS e Asaas. GUARDE NO COFRE.
MASTER_KEY=
# Proxies confiáveis na frente do servidor (para ler o IP real no X-Forwarded-For).
# 0 (padrão) = sem proxy, porta exposta direto. Atrás do Cloudflare Tunnel ou do Caddy, use 1.
TRUST_PROXY=0
# Vinculação imediata à Nexor Central: código do cliente (Central → Clientes → cliente)
NEXOR_CODIGO=
NEXOR_CENTRAL_URL=
# WhatsApp, SMS, login com Google e Asaas são configurados pela própria barbearia no painel (Configurações).
