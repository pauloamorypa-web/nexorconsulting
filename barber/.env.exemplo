# Nexor Barber (desenvolvimento local). Na implantação, use implantacao/.env (instalar.sh).
PORT=8795
DATA_DIR=./data
# Endereço público do app (vai nos links do WhatsApp): https://agenda.suabarbearia.com.br
PUBLIC_URL=
# Obrigatória em produção: criptografa os tokens do WhatsApp, SMS e Asaas. GUARDE NO COFRE.
MASTER_KEY=
# Vinculação imediata à Nexor Central: código do cliente (Central → Clientes → cliente)
NEXOR_CODIGO=
NEXOR_CENTRAL_URL=
# WhatsApp, SMS, login com Google e Asaas são configurados pela própria barbearia no painel (Configurações).

# LGPD
# Versão vigente dos Termos de Uso e da Política de Privacidade. Mudou o valor, todo usuário do painel aceita de novo.
TERMOS_VERSAO=2026-11-09
# Endereço dos termos mostrado na tela de aceite
TERMOS_URL=
# Prazos de guarda em meses, por cima dos padrões (ver GET /api/lgpd/prazos). Ex.: {"lead": 6}
# Categorias de guarda legal (trabalhista, fiscal) só bloqueiam: nunca viram exclusão automática.
LGPD_PRAZOS=
