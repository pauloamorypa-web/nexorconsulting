# Nexor Contábil (desenvolvimento local). Na implantação, use implantacao/.env (instalar.sh).
PORT=8793
DATA_DIR=./data
PUBLIC_URL=
# Obrigatória em produção: criptografa os arquivos dos clientes e os tokens. GUARDE NO COFRE.
MASTER_KEY=
# Leitura de documentos e assistente do WhatsApp (Claude). Sem ela, o resto funciona e a leitura fica desligada.
ANTHROPIC_API_KEY=
# Vinculação imediata à Nexor Central: código do cliente (Central → Clientes → cliente)
NEXOR_CODIGO=
NEXOR_CENTRAL_URL=
