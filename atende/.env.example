# ---------- Nexor Atende IA ----------

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo e esforço. "low" responde rápido e gasta menos; "medium" pensa mais em cada resposta.
NEXOR_MODEL=claude-opus-5-5
NEXOR_EFFORT=low
NEXOR_COPILOT_EFFORT=low
# A cada quantas mensagens do cliente a IA refaz a análise (sentimento, intenção, temperatura do lead)
NEXOR_ANALYZE_EVERY=3

# Endereço público do servidor (aparece no painel como URL do webhook)
PUBLIC_URL=https://atende.nexorconsultingit.com.br

# Texto aleatório e longo. Criptografa os tokens da Meta no banco. NÃO troque depois de configurar.
MASTER_KEY=

# true = qualquer empresa pode criar conta (modo SaaS). Sem isso, só o primeiro acesso cria a conta.
ALLOW_SIGNUP=false

# Pasta do banco SQLite e das mídias (use um disco persistente em produção)
DATA_DIR=./data

# ---------- Meta (WhatsApp Cloud API) ----------
# Segredo do app (developers.facebook.com → seu app → Configurações do app → Básico → Chave secreta)
META_APP_SECRET=
# Texto que você inventa e cola igual na configuração do webhook da Meta. Vazio = gerado automaticamente.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Opcional, para o botão "Conectar com o Facebook" (cadastro incorporado / Embedded Signup)
META_APP_ID=
META_CONFIG_ID=

PORT=8790
